# Ollama (systeme RAG, 100% local)
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=

# Juge d'evaluation (eval/generation_eval.py UNIQUEMENT, jamais le generateur
# RAG qui reste 100% local/Ollama). LLM_PROVIDER choisit le fournisseur :
# "anthropic" (defaut) ou "bedrock". Ne jamais committer de vraie cle/jeton :
# .env est dans .gitignore, ce fichier n'est qu'un modele.
LLM_PROVIDER=anthropic

# --- LLM_PROVIDER=anthropic (API Anthropic directe) ---
ANTHROPIC_API_KEY=
# claude-sonnet-5 et claude-opus-5 rejettent le parametre temperature
# (requis en interne par RAGAS pour plusieurs metriques) : verifie en direct,
# ce sont les seuls modeles Claude actuels a l'accepter normalement.
ANTHROPIC_JUDGE_MODEL=claude-haiku-4-5-20251001

# --- LLM_PROVIDER=bedrock (Amazon Bedrock, API Converse) ---
# Jeton porteur Bedrock : jamais lu/logue par le code, seule sa PRESENCE est
# verifiee - botocore le detecte lui-meme dans l'environnement du processus.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=
BEDROCK_JUDGE_MODEL_ID=
